class AlienShots {
    field Array shotsArray;
    field int reloadTime, tickCounter, shotIndex, nextShot;

    constructor AlienShots new() {
        var Array tempArray;
        let tempArray = Array.new(3);
        let shotsArray = tempArray;

        do shotsArray.set(0, AlienShot.new(Math.divide(224, 2), 176, AlienShot.getROLLER()));
        do shotsArray.set(1, AlienShot.new(Math.divide(224, 2), 176, AlienShot.getPLUNGER()));
        do shotsArray.set(2, AlienShot.new(Math.divide(224, 2), 176, AlienShot.getSQUIGGLY()));

        let reloadTime = 200;
        let tickCounter = 0;
        let shotIndex = 0;
        let nextShot = 0;

        return this;
    }

    method void init() {
        do resetShots();
        let reloadTime = 200;
        let tickCounter = 0;
        let shotIndex = 0;
        let nextShot = 0;
        return;
    }

    method void resetShots() {
        var int i;
        var AlienShot shot;
        let i = 0;

        while (i < 3) {
            let shot = shotsArray.get(i);
            do shot.resetTicks();
            let i = i + 1;
        }
        return;
    }

    method void dispose() {
        var int i;
        var AlienShot shot;
        let i = 0;

        while (i < 3) {
            let shot = shotsArray.get(i);
            do shot.dispose();
            let i = i + 1;
        }
        do Memory.deAlloc(this);
        return;
    }

    method boolean tick(int tickMultiplier, int startX, int startY, boolean active) {
        var int i, result;
        var AlienShot shot;

        let tickCounter = tickCounter + 1;

        if (tickCounter > reloadTime) {
            let reloadTime = 80;
            let i = shotIndex;

            while (i < 3) {
                let shot = shotsArray.get(i);
                if (~shot.isActive()) {
                    if (i = 0) {
                        let nextShot = startY;
                    }
                    if (i > 0) {
                        let nextShot = nextShot + 1;
                    }

                    let result = shot.fire(nextShot + startX, tickMultiplier);
                    let nextShot = nextShot + startX + result;
                    let tickCounter = 0;
                    let shotIndex = Math.mod(shotIndex + 1, 3);
                    let i = 3;
                }
                if (shot.isActive()) {
                    let i = i + 1;
                }
            }
        }

        let i = 0;
        while (i < 3) {
            let shot = shotsArray.get(i);
            if (shot.tick()) {
                let reloadTime = 260;
                return true;
            }
            let i = i + 1;
        }

        return false;
    }

    method void draw() {
        var int i;
        var AlienShot shot;
        let i = 0;

        while (i < 3) {
            let shot = shotsArray.get(i);
            do shot.draw();
            let i = i + 1;
        }

        return;
    }

    method boolean checkCollision(int missileY) {
        var int i;
        var boolean collision;
        var AlienShot shot;
        let i = 0;
        let collision = false;

        while (i < 3) {
            let shot = shotsArray.get(i);
            if (shot.checkCollision(missileY)) {
                let collision = true;
            }
            let i = i + 1;
        }

        return collision;
    }

    method int update() {
        var int i;
        var boolean hit;
        var AlienShot shot;
        let i = 0;
        let hit = false;

        while (i < 3) {
            let shot = shotsArray.get(i);
            if (shot.update()) {
                let hit = true;
            }
            let i = i + 1;
        }

        if (hit) {
            return 1;
        }
        return 0;
    }

    function AlienShots AlienShots_init() {
        var AlienShots alienShotsInstance;

        let alienShotsInstance = AlienShots.new();
        do alienShotsInstance.init();

        return alienShotsInstance;
    }
}